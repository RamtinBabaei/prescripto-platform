{
  "name": "prescripto-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:ui": "vite --host 0.0.0.0",
    "build": "vite build && node scripts/build-worker.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src worker tests",
    "test": "vitest run",
    "db:migrate": "wrangler d1 migrations apply prescripto-db --local",
    "db:seed": "wrangler d1 execute prescripto-db --local --file db/seed.sql",
    "setup": "npm run db:migrate && npm run db:seed && npm run build",
    "deploy": "npm run build && wrangler deploy",
    "types": "wrangler types",
    "staff:create": "node scripts/create-staff.mjs",
    "format": "prettier --write src worker tests scripts docs *.json *.ts *.md",
    "format:check": "prettier --check src worker tests scripts docs *.json *.ts *.md"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.4",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@tailwindcss/vite": "^4.1.16",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.9.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.25.11",
    "eslint": "^9.38.0",
    "jsdom": "^30.1.3",
    "miniflare": "^5.20261019.2-beta",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.16",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^7.1.12",
    "vitest": "^5.0.5",
    "wrangler": "^4.45.0"
  }
}
